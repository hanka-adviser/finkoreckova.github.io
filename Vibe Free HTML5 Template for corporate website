@charset "utf-8";

@import url("http://fonts.googleapis.com/css?family=Raleway:400,700,500");

body { padding-top: 100px; background: rgb(255, 255, 255); font-family: Raleway, sans-serif; font-weight: 400; color: rgb(40, 40, 40); line-height: 26px; }

h1, h2, h3, h4, h5, h6 { font-weight: 600; font-family: Raleway, sans-serif; }

a { color: rgb(69, 174, 214); transition: color 400ms, background-color 400ms; }

a:hover, a:focus { text-decoration: none; color: rgb(42, 149, 190); }

hr { border-top: 1px solid rgb(229, 229, 229); border-bottom: 1px solid rgb(255, 255, 255); }

.gradiant { background-image: -webkit-linear-gradient(90deg, rgb(44, 170, 179) 0%, rgb(44, 140, 179) 100%); }

.gradiant-horizontal { background-image: -webkit-linear-gradient(4deg, rgb(44, 170, 179) 0%, rgb(44, 140, 179) 100%); }

.section-header { margin-bottom: 50px; }

.section-header .section-title { font-size: 44px; color: rgb(79, 79, 79); text-transform: uppercase; position: relative; padding-bottom: 20px; margin: 0px 0px 20px; border-bottom: 2px solid rgb(37, 164, 215); display: inline-block; }

.section-header .section-title::before { content: ""; position: absolute; width: 140px; bottom: 0px; left: 50%; margin-left: -70px; height: 4px; }

.btn { border-width: 0px; border-radius: 0px; }

.btn.btn-primary { background: rgb(37, 164, 215); }

.btn.btn-primary:hover, .btn.btn-primary:focus { background: rgb(8, 92, 152); }

.column-title { margin-top: 0px; padding-bottom: 15px; border-bottom: 1px solid rgb(238, 238, 238); margin-bottom: 15px; position: relative; }

.column-title::after { content: " "; position: absolute; bottom: -1px; left: 0px; width: 40%; }

ul.nostyle { list-style: none; padding: 0px; margin-bottom: 20px; }

ul.nostyle i { color: rgb(69, 174, 214); }

.scaleIn { animation-name: scaleIn; }

.navbar-toggle { border-radius: 0px; }

.navbar-default .navbar-collapse, .navbar-default .navbar-form { border-color: rgb(69, 177, 218); }

.navbar-nav > li > a { text-transform: uppercase; }

@-webkit-keyframes scaleIn { 
  0% { opacity: 0; transform: scale(0); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes scaleIn { 
  0% { opacity: 0; transform: scale(0); }
  100% { opacity: 1; transform: scale(1); }
}

#main-nav.navbar-default { background: rgb(255, 255, 255); }

#main-nav.navbar-default .navbar-nav > li.active > a, #main-nav.navbar-default .navbar-nav > li.open > a, #main-nav.navbar-default .navbar-nav > li:hover > a { background: rgb(59, 136, 192); color: rgb(255, 255, 255); }

.navbar.navbar-default { border: 0px; border-radius: 0px; margin-bottom: 0px; }

.navbar.navbar-default .navbar-toggle { margin-top: 32px; }

.navbar.navbar-default .navbar-brand { height: auto; padding: 22px 15px 21px; }

.navbar-default .navbar-nav > li > a:hover, .navbar-default .navbar-nav > li > a:focus { color: rgb(255, 255, 255); background: rgb(8, 92, 152); }

.navbar-default .navbar-nav > li > a { color: rgb(255, 255, 255); }

#main-nav.navbar-default { background: rgb(8, 92, 152); }

@media only screen and (min-width: 768px) {
  #main-nav.navbar-default { background: rgb(8, 92, 152); box-shadow: rgba(0, 0, 0, 0.26) 0px 0px 3px 0px; }
  #main-nav.navbar-default .navbar-nav > li > a { padding-top: 40px; padding-bottom: 36px; border-bottom: 4px solid transparent; }
  .navbar-default .navbar-nav > li > a { color: rgb(255, 255, 255); }
  #main-nav.navbar-default .navbar-nav > li.active > a, #main-nav.navbar-default .navbar-nav > li.open > a, #main-nav.navbar-default .navbar-nav > li:hover > a { background: rgb(45, 121, 176); color: rgb(255, 255, 255); border-bottom: 4px solid rgb(255, 255, 255); }
  #main-nav.navbar-default .dropdown-menu { padding: 0px 20px; min-width: 220px; background-color: rgba(26, 28, 40, 0.9); border: 0px; border-radius: 0px; box-shadow: none; background-clip: inherit; }
  #main-nav.navbar-default .dropdown-menu > li { border-left: 3px solid transparent; margin-left: -20px; padding-left: 17px; transition: border-color 400ms; }
  #main-nav.navbar-default .dropdown-menu > li > a { padding: 15px 0px; color: rgb(168, 168, 168); }
  #main-nav.navbar-default .dropdown-menu > li:first-child > a { border-top: 0px; }
  #main-nav.navbar-default .dropdown-menu > li.active, #main-nav.navbar-default .dropdown-menu > li.open, #main-nav.navbar-default .dropdown-menu > li:hover { border-left-color: rgb(69, 174, 214); }
  #main-nav.navbar-default .dropdown-menu > li.active > a, #main-nav.navbar-default .dropdown-menu > li.open > a, #main-nav.navbar-default .dropdown-menu > li:hover > a { color: rgb(69, 174, 214); background-color: transparent; }
}

#hero-banner { overflow: hidden; height: 650px; color: rgb(76, 76, 76); border-bottom: 1px solid rgb(189, 189, 189); }

#hero-banner.item { height: 558px; background-repeat: no-repeat; background-position: 50% 0px; background-size: cover; }

#hero-banner.banner-inner { position: absolute; top: 0px; left: 0px; width: 100%; height: 100%; color: rgb(0, 0, 0); }

#hero-banner { background: url("../images/banner/bg1.png") 77% bottom no-repeat; }

#hero-banner h2 { margin-top: 180px; font-size: 39px; line-height: 49px; }

#hero-banner.banner-inner h2 > span { color: rgb(69, 174, 214); }

#hero-banner.banner-inner .btn { margin-top: 10px; }

#hero-text { padding: 50px 0px; border-top: 1px solid rgb(255, 255, 255); background: rgb(8, 92, 152); color: rgb(244, 244, 244); }

#hero-text h2 { margin-top: 0px; }

#hero-text .btn { margin-top: 40px; color: rgb(8, 92, 152); background: rgb(255, 255, 255); }

#cta2 { background: rgb(69, 177, 218); color: rgb(255, 255, 255); padding-top: 70px; }

#cta2 .btn { margin-top: 10px; }

#cta2 h2 { color: rgb(255, 255, 255); font-size: 44px; line-height: 1; }

#cta2 h2 > span { color: rgb(69, 174, 214); }

#features h2, #portfolio p { color: rgb(74, 74, 74); }

#features { padding: 100px 0px; background: rgb(255, 255, 255); color: rgb(0, 0, 0); }

#features .media.service-box:first-child { margin-top: 80px; }

#services { padding: 100px 0px 75px; }

.media.service-box { margin: 25px 0px 36px; }

.media.service-box .pull-left { margin-right: 20px; }

.media.service-box .pull-left > i { font-size: 42px; height: 94px; line-height: 64px; text-align: center; width: 106px; color: rgb(8, 92, 152); transition: background-color 400ms, background-color 400ms; position: relative; border: 1px solid rgb(208, 208, 208); padding: 14px; }

.features .media.service-box .pull-left > i { color: rgb(181, 181, 181); }

.media.service-box:hover .pull-left > i { }

#portfolio { padding: 100px 0px; background: rgb(255, 255, 255); }

#portfolio .portfolio-filter { list-style: none; padding: 0px; margin: 0px 0px 50px; display: inline-block; }

#portfolio .portfolio-filter > li { float: left; display: block; }

#portfolio .portfolio-filter > li a { display: block; padding: 7px 15px; margin: 0px 2px; color: rgb(8, 92, 152); position: relative; border-bottom: 2px solid transparent; }

#portfolio .portfolio-filter > li a:hover, #portfolio .portfolio-filter > li a.active { background: rgb(240, 240, 240); color: rgb(8, 92, 152); border-bottom: 2px solid rgb(8, 92, 152); }

#portfolio .portfolio-items { margin: -15px; }

